---
import type { projects } from '../data/site';
type Project = typeof projects[number];
const { project } = Astro.props as {project: Project};
---
<article class="project-card">
  <div class="project-top"><span class="pill">{project.status}</span><span class="project-index">{project.number}</span></div>
  <h3>{project.title}</h3>
  <p>{project.lead}</p>
  <div class="stack" aria-label="Technologies">{project.stack.map((item) => <span>{item}</span>)}</div>
  <a class="card-link" href={project.url} aria-label={`Read about ${project.title}`}>Explore project <span aria-hidden="true">↗</span></a>
</article>
